# =============================================================================
# Jamf-SnipeIT Suite - Unified Configuration
# =============================================================================
# Copy this file to config.yaml and fill in your credentials.
# NEVER commit config.yaml to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Jamf Pro Configuration
# -----------------------------------------------------------------------------
jamf:
  base_url: "https://your-company.jamfcloud.com"
  # Authentication: username/password OR client_id/client_secret
  username: "your_jamf_username"
  password: "your_jamf_password"
  # OAuth2 client credentials (alternative to username/password)
  client_id: ""
  client_secret: ""
  # Extension Attribute for storing Snipe-IT Asset ID
  ea_snipe_asset_id: "SnipeIT_Asset_ID"
  # Smart group for user matching (Jamf_User_Match module)
  smart_group: "All Managed Clients"

# -----------------------------------------------------------------------------
# Snipe-IT Configuration
# -----------------------------------------------------------------------------
snipeit:
  base_url: "https://your-snipeit-instance.com"
  api_token: "your_snipeit_api_token"
  # Status IDs (get these from your Snipe-IT admin)
  status_deployed_id: 1
  status_pending_id: 8
  status_checkedout_id: 2
  # Default fallback IDs
  model_fallback_id: 40
  company_id: 1
  location_id: 0
  category_id: 0

# -----------------------------------------------------------------------------
# Azure AD / Microsoft Graph Configuration
# -----------------------------------------------------------------------------
azure:
  tenant_id: "your-tenant-id"
  client_id: "your-client-id"
  client_secret: "your-client-secret"
  scope: "https://graph.microsoft.com/.default"
  # Azure AD groups
  starters_group_id: "azure-group-id-for-starters"
  leavers_group_id: "azure-group-id-for-leavers"
  disabled_group_id: "azure-group-id-for-disabled-users"

# -----------------------------------------------------------------------------
# HiBob Configuration (optional — used by Peripherals Sync)
# -----------------------------------------------------------------------------
hibob:
  enabled: false
  base_url: "https://api.hibob.com/v1"
  service_user_id: ""
  service_user_token: ""
  equipment_field: ""  # auto-discovered if blank

# -----------------------------------------------------------------------------
# Slack Notifications (optional)
# -----------------------------------------------------------------------------
slack:
  enabled: false
  bot_token: "xoxb-your-slack-bot-token"
  channel_id: "C0123456789"
  notify_module_summary: true  # post run summary (errors only)

# -----------------------------------------------------------------------------
# User Matching Configuration
# (Used by Jamf_User_Match module)
# -----------------------------------------------------------------------------
matching:
  email_domain: "yourcompany.com"
  min_score: 14
  weight_lcs: 1.0
  weight_char_overlap: 0.3
  weight_bigram_dice: 2.0
  use_bigram_dice: true
  allow_reassignment: true

# -----------------------------------------------------------------------------
# Module-Specific Settings
# -----------------------------------------------------------------------------
modules:
  # Leavers module settings
  leavers:
    enabled: true
    auto_mode: false  # If true, runs automatically on schedule
    interval_days: 7
    lookback_days: 15

  # Rehire Detection: restores [Disabled] users whose AAD account is
  # active again (strips prefix, restores Pending assets to Deployed)
  rehire_detection:
    enabled: true
    # SAFETY LATCH: config dry_run can only force dry-run ON, never off
    dry_run: true
    # Require HiBob (HR source of truth, read-only) to confirm the person
    # is an active employee before auto-restoring
    hibob_confirmation: true

  # User Match module settings
  user_match:
    enabled: true
    dry_run: false
    batch_size: 100
    batch_delay_seconds: 30

  ai_audit:
    enabled: true
    allow_external_pii: false  # tokenise names, emails, serials, and IDs sent to the LLM

  health_check:
    enabled: true
    max_workers: 8
    scan_error_ratio_threshold: 0.1

  # Model Sync module settings
  model_sync:
    enabled: true
    dry_run: false
    update_delay_seconds: 0.2
    auto_create_models: true
    auto_create_manufacturers: true
    default_category_id: 1  # Category for new models

  # Snipe to Jamf sync settings
  snipe_to_jamf:
    enabled: true
    dry_run: false
    update_delay_seconds: 0.2

  # Wake-Up module settings
  wakeup:
    enabled: true
    default_group_id: ""

  # Cleanup module settings — detects and merges duplicate Snipe-IT users
  # (reassigns assets, then DELETES the loser account)
  cleanup:
    enabled: true
    # SAFETY LATCH: config dry_run can only force dry-run ON, never off.
    # This module deletes user accounts — leave true until the merge
    # heuristic has a track record, then flip to false after reviewing
    # DRY RUN log output.
    dry_run: true

# -----------------------------------------------------------------------------
# Scheduler Configuration
# -----------------------------------------------------------------------------
scheduler:
  enabled: false  # Set to true to enable scheduled execution
  timezone: "Europe/London"
  run_on_startup: true
  jitter_seconds: 180  # adds random delay to each job to avoid API bursts
  jobs:
    azure_starters:
      cron: "50 5 * * 1"   # Monday 05:50 AM
      enabled: false
    user_enrichment:
      cron: "10 6 * * 1"  # Monday 06:10 AM
      enabled: false
    model_sync:
      cron: "45 16 * * 2"   # Tuesday 16:45 PM
      enabled: false
    # Rehire Detection must run BEFORE correction/user_match/leavers
    rehire_detection:
      cron: "30 17 * * 2"  # Tuesday 17:30 PM
      enabled: false
    correction:
      cron: "5 17 * * 2"  # Tuesday 17:05 PM
      enabled: false
    user_match:
      cron: "20 17 * * 2"  # Tuesday 17:20 PM
      enabled: false
    snipe_to_jamf:
      cron: "40 17 * * 2"   # Tuesday 17:40 PM
      enabled: false
    leavers:
      cron: "0 18 * * 2"  # Tuesday 18:00 PM
      enabled: false
    peripherals_sync:
      cron: "30 6 * * 1"   # Monday 06:30 AM
      enabled: false

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  dir: "./logs"
  audit_csv: true
  max_log_files: 30  # Days to keep logs

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
api:
  timeout_seconds: 30
  max_retries: 3
  retry_delay_seconds: 2
  rate_limit_wait_seconds: 60
